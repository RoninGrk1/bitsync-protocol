# WalletConnect Cloud project id
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=bitsync_placeholder_project_id

# Chain (default: local Anvil)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Contract addresses (filled by scripts/local-presale-demo.sh)
NEXT_PUBLIC_BSY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PRESALE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDT_ADDRESS=0x0000000000000000000000000000000000000000

# Compliance (server-only — never NEXT_PUBLIC)
BLOCKED_COUNTRIES=US,GB,UK
KYC_REQUIRED=false
# KYC_PROVIDER=stub   # local demos only; omit / unset = fail closed
# COMPLIANCE_SIGNER_KEY=0x...   # required to sign KYC; no default
